# ---------------------------------------------------------------------------
# Personal AI Assistant - Backend Configuration
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Auth (single-user by default; a user is auto-created on first boot)
# Generate a long random string for JWT_SECRET, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
APP_USERNAME=admin
# Plaintext password used ONLY to seed the first user on first run.
# After first boot you can remove this; the stored hash is what matters.
APP_PASSWORD=change-me

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
# Cost-effective general chat model (override as new cheaper/better models ship)
OPENAI_MODEL=gpt-4o-mini
# Used for the STT+TTS voice pipeline and browser-STT mode
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1
# Used for the OpenAI Realtime (live voice) mode
OPENAI_REALTIME_MODEL=gpt-realtime

# Database
# If DATABASE_URL is set, PostgreSQL is used. Otherwise SQLite is used (recommended for local/dev).
# Example Postgres URL: postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Path to the SQLite file when DATABASE_URL is not set
SQLITE_PATH=./data/app.db

# Web search tool
# Optional Tavily API key (https://tavily.com) for higher quality results.
# If left blank, the web_search tool falls back to the free DuckDuckGo Instant Answer API.
TAVILY_API_KEY=

# Placeholder API tool (template for future integrations)
PLACEHOLDER_API_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Logging
LOG_LEVEL=info
