{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://ai-assistant-backend-dhi6.onrender.com"
    }
  },
  "rewrites": [
    { "source": "/ir", "destination": "/ir/index.html" },
    { "source": "/ir/", "destination": "/ir/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
