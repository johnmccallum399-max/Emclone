{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://ai-assistant-backend-dhi6.onrender.com"
    }
  },
  "rewrites": [
    { "source": "/finder", "destination": "/finder/index.html" },
    { "source": "/finder/", "destination": "/finder/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
