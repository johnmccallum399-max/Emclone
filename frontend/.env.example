# Base URL of the backend API. In local dev with the Vite proxy you can
# leave this unset; in production set it to your deployed backend's URL.
VITE_API_BASE_URL=http://localhost:4000

# ElevenLabs Conversational AI agent used by the "elevenlabs" voice mode
# (cmdr Montebank). Must be a public agent; defaults to the baked-in agent ID
# if unset.
VITE_ELEVENLABS_AGENT_ID=agent_0701kwm991q5etvrar8ndy4zyy8k
